<?xml version="1.0"?>
<package format="3">
  <name>rehab_robot_bridge</name>
  <version>0.1.0</version>
  <description>Unified simulation/hardware ROS 2 robot state and parameter bridge.</description>
  <maintainer email="todo@example.invalid">Rehab development team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>python3-numpy</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>rehab_interfaces</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
